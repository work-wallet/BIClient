	/// Text for the Issues list drillthrough button; reflects the issue selected in the table.
	measure 'Issue Details Button Label' =
			VAR Selected = IF ( HASONEVALUE ( 'Issue'[Issue Reference] ), VALUES ( 'Issue'[Issue Reference] ) )
			RETURN
			    IF ( ISBLANK ( Selected ), "Select an issue to view details", "View " & Selected & " details  ›" )
		isHidden
		displayFolder: Labels
		lineageTag: 56d61e46-47e8-5009-8885-69e4891d64e5

	/// The selected issue's overview, for the details page.
	measure 'Issue Overview Text' =
			VAR Overview = SELECTEDVALUE ( 'Issue'[Issue Overview] )
			RETURN
			    IF ( LEN ( Overview ) > 0, Overview, "No overview recorded." )
		isHidden
		displayFolder: Labels
		lineageTag: 40e3b472-caad-553b-a052-a49a78ee7cf4

	/// One-line timeline for the selected issue: who reported it and the time to report, to investigation and to close.
	measure 'Issue Timeline' =
			VAR ReportedBy = SELECTEDVALUE ( 'Issue'[Reported By] )
			VAR HoursToReport = SELECTEDVALUE ( 'Issue'[Hours To Report] )
			VAR DaysToInvestigate = SELECTEDVALUE ( 'Issue'[Days To Start Investigation] )
			VAR DaysToClose = SELECTEDVALUE ( 'Issue'[Days To Close] )
			VAR Reported =
			    "Reported "
			        & IF ( LEN ( ReportedBy ) > 0, "by " & ReportedBy & " " )
			        & SWITCH (
			            TRUE (),
			            ISBLANK ( HoursToReport ), "(time not recorded)",
			            HoursToReport < 1, "within an hour of occurring",
			            HoursToReport < 2, "within 2 hours of occurring",
			            HoursToReport < 48, FORMAT ( HoursToReport, "#,0" ) & " hours after it occurred",
			            FORMAT ( HoursToReport / 24, "#,0" ) & " days after it occurred"
			        )
			VAR Investigated =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DaysToInvestigate ), "investigation not started",
			        DaysToInvestigate < 1, "investigation started the same day",
			        DaysToInvestigate < 2, "investigation started the next day",
			        "investigation started " & FORMAT ( DaysToInvestigate, "#,0" ) & " days after report"
			    )
			VAR Closed =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( DaysToClose ), "not closed",
			        DaysToClose < 1, "closed the same day",
			        DaysToClose < 2, "closed the next day",
			        "closed " & FORMAT ( DaysToClose, "#,0" ) & " days after report"
			    )
			RETURN
			    IF ( HASONEVALUE ( 'Issue'[ReportedIssue_key] ), Reported & " · " & Investigated & " · " & Closed )
		isHidden
		displayFolder: Labels
		lineageTag: 0523a3e5-86b3-5b5e-ada4-dba31566c5e0

	/// Category of the selected issue, read from the issue's own row so it is right however the page is filtered.
	measure 'Issue Category' = IF ( HASONEVALUE ( 'Issue'[ReportedIssue_key] ), MAXX ( 'Issue', RELATED ( 'Category'[Category] ) ) )
		isHidden
