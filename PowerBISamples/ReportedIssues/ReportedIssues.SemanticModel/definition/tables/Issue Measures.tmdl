	/// More reports isn't necessarily bad (it can reflect a healthy reporting culture), so the issue count trend is shown in a neutral colour.
	measure 'Issues Trend Colour' = [Colour Neutral]
		isHidden
		displayFolder: Formatting
		lineageTag: 986c9eb0-c16e-5934-b2c4-3802bdaeaf08

	measure 'Serious Trend Colour' =
			VAR Cur = [Serious Issues]
			VAR Prev = [Serious Issues PP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Prev ) || Prev = 0 || Cur = Prev, [Colour Neutral],
			        Cur > Prev, [Colour Bad],
			        [Colour Good]
			    )
		isHidden
		displayFolder: Formatting
		lineageTag: c182c871-ba03-579c-87b8-14fed0fbb195

	measure 'Injury Trend Colour' =
			VAR Cur = [Injury Reports]
			VAR Prev = [Injury Reports PP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Prev ) || Prev = 0 || Cur = Prev, [Colour Neutral],
			        Cur > Prev, [Colour Bad],
			        [Colour Good]
			    )
		isHidden
		displayFolder: Formatting
		lineageTag: 95589c5b-e282-59d4-94bf-2005e72a12f5

	measure 'Days To Close Trend Colour' =
			VAR Cur = [Average Days To Close]
			VAR Prev = [Average Days To Close PP]
