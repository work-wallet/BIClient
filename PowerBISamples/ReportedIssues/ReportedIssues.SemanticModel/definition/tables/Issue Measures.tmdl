		lineageTag: 0ca16fa7-b13c-548d-bd56-b50cf618c448

	/// Colour for a severity code (Critical, High, Medium, Low, not set); severities are a fixed list in Work Wallet.
	measure 'Severity Colour' =
			SWITCH (
			    SELECTEDVALUE ( 'Severity'[ReportedIssueSeverityCode] ),
			    8, "#D6493A",
			    4, "#E07B39",
			    2, "#ECB232",
			    1, "#2E9E6B",
			    "#A7B4C2"
			)
		isHidden
