	measure 'Completed Trend Colour' =
			VAR Cur = [Completed Inspections]
			VAR Prev = [Completed Inspections PP]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( Prev ) || Prev = 0 || Cur = Prev, [Colour Neutral],
			        Cur > Prev, [Colour Good],
			        [Colour Bad]
			    )
		isHidden
