		displayFolder: Formatting
		lineageTag: c40ce862-dfd4-52e7-bd15-3b7a50081ccd

	/// Text colour for an inspection status code (Complete, InProgress, ReadyForReview); statuses are a fixed list in Work Wallet.
	measure 'Inspection Status Colour' =
			SWITCH (
			    SELECTEDVALUE ( 'Inspection Status'[InspectionStatusCode] ),
			    0, "#2E9E6B",
			    2, "#C9901A",
			    4, "#2F6F8F",
			    "#4A5568"
			)
		isHidden
		displayFolder: Formatting
		lineageTag: 20bc2f00-8451-5fa0-9c21-d8159562d0b1

	/// Text colour for an observation status code (Defect (Open), Defect (Closed), Observation); a fixed list in Work Wallet.
	measure 'Observation Status Colour' =
			SWITCH (
			    SELECTEDVALUE ( 'Observation Status'[AssetObservationStatusCode] ),
			    1, "#D6493A",
			    32, "#2E9E6B",
			    "#4A5568"
			)
		isHidden
		displayFolder: Formatting
		lineageTag: 57dcb10a-916c-5cc4-9e1c-f1c867f0b2a6

	/// Work Wallet link for the selected asset, for the 'Open in Work Wallet' button on its details page.
	measure 'Asset Link' = SELECTEDVALUE ( Asset[Url] )
		isHidden
		displayFolder: Links
		lineageTag: 3d7c433f-1a18-5e4b-9324-f5fa2316b9b0

	/// Work Wallet link for the selected inspection, for the 'Open in Work Wallet' button on its details page.
	measure 'Inspection Link' = SELECTEDVALUE ( Inspection[Url] )
		isHidden
		displayFolder: Links
		lineageTag: be04fff3-76b0-5e8f-92ce-b700815301f9

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: bf8b56eb-9474-51ab-aaff-81118864387b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition 'Asset Measures' = calculated
		mode: import
		source = { 1 }

	annotation PBI_Id = 39b0f50ef71b543ab34726ca4c0e7763

