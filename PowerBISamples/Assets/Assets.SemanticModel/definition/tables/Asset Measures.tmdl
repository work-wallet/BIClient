	/// Says how many assets the status filter hides (by default the report shows Active assets, as the Work Wallet portal does).
	measure 'Active Assets Label' =
			VAR OtherStatuses = [Assets Any Status] - [Assets]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( [Assets Any Status] ), BLANK (),
			        OtherStatuses > 0, FORMAT ( OtherStatuses, "#,0" ) & " more with other statuses (see Filters)",
			        "All statuses shown"
			    )
		isHidden
		displayFolder: Labels
		lineageTag: c9d0babe-6d25-5c6c-8c81-500752c70e5a

