table 'Asset Measures'
	lineageTag: ba4bd339-186c-593e-b84c-e4c2eabab620

	/// Number of assets.
	measure Assets = COUNTROWS ( Asset )
		formatString: #,0
		displayFolder: Assets
		lineageTag: 186c1035-c708-558f-a08f-514ef703f24d

	/// Assets of any status except Deleted, ignoring status filters (e.g. the report's default Active filter).
	measure 'Assets Any Status' = CALCULATE ( [Assets], REMOVEFILTERS ( 'Asset Status' ), KEEPFILTERS ( 'Asset Status'[AssetStatusCode] <> 3 ) )
		formatString: #,0
		displayFolder: Assets
		lineageTag: f8e63ddf-e741-5ead-b4ab-00e82507301b

	/// Assets with status Active.
	measure 'Active Assets' = CALCULATE ( [Assets], KEEPFILTERS ( 'Asset Status'[AssetStatusCode] = 0 ) )
		formatString: #,0
		displayFolder: Assets
		lineageTag: d22788e6-ad20-57df-8706-7eab0081ce25

	/// Assets with status Out of Service.
	measure 'Out Of Service Assets' = CALCULATE ( [Assets], KEEPFILTERS ( 'Asset Status'[AssetStatusCode] = 1 ) )
		formatString: #,0
		displayFolder: Assets
		lineageTag: 0f955f8c-192f-5cb0-a12c-974c60e58357

	/// Active assets with no completed inspection.
	measure 'Active Assets Never Inspected' = CALCULATE ( [Active Assets], KEEPFILTERS ( Asset[Inspection Band Order] = 5 ) )
		formatString: #,0
		displayFolder: Assets
		lineageTag: 4d9b2e45-fd74-54ba-8da7-adad1d5d3500

	/// Active assets last inspected over a year ago, or never inspected (as at the last data refresh).
	measure 'Active Assets Not Inspected In A Year' = CALCULATE ( [Active Assets], KEEPFILTERS ( Asset[Inspection Band Order] >= 4 ) )
		formatString: #,0
		displayFolder: Assets
		lineageTag: 1cdefd79-24e7-5d07-9a78-9a76b9be68ee

	/// Assets with at least one open defect (as at the last data refresh).
	measure 'Assets With Open Defects' = CALCULATE ( [Assets], KEEPFILTERS ( Asset[Open Defects] > 0 ) )
		formatString: #,0
		displayFolder: Assets
		lineageTag: 465fa918-059e-5edf-a080-3e321da2a3f2

	/// Distinct asset types.
	measure 'Asset Types' = DISTINCTCOUNT ( Asset[Asset Type] )
		formatString: #,0
		displayFolder: Assets
		lineageTag: 11713db3-6317-5c20-8caf-f27b029eed7f

	/// Asset type with the most assets; ties are reported.
	measure 'Most Common Asset Type' =
			VAR Items = FILTER ( ADDCOLUMNS ( VALUES ( Asset[Asset Type] ), "@Value", [Assets] ), NOT ISBLANK ( [@Value] ) )
			VAR Target = MAXX ( Items, [@Value] )
			VAR Leaders = FILTER ( Items, [@Value] = Target )
			VAR LeaderCount = COUNTROWS ( Leaders )
			VAR FirstLeader = MINX ( Leaders, Asset[Asset Type] )
			RETURN
			    IF ( LeaderCount > 1, FirstLeader & " (+" & ( LeaderCount - 1 ) & " tied)", FirstLeader )
		displayFolder: Assets
		lineageTag: 5bcc5eb2-e7fe-5d76-8de9-c3bb96a24e93

	/// Number of inspections.
	measure Inspections = COUNTROWS ( Inspection )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: 97a7e200-7d22-50cd-8a82-e94315f9e236

	/// Inspections with status Complete.
	measure 'Completed Inspections' = CALCULATE ( [Inspections], KEEPFILTERS ( 'Inspection Status'[InspectionStatusCode] = 0 ) )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: 191d081f-37f1-5c9f-94f3-14a7e1fbc188

	/// Inspections in progress or ready for review.
	measure 'Open Inspections' = CALCULATE ( [Inspections], KEEPFILTERS ( 'Inspection Status'[InspectionStatusCode] IN { 2, 4 } ) )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: 770f81ea-1b53-5ee7-bdf9-979baa8ccb18

	/// Completed inspections that raised at least one new defect.
	measure 'Inspections With Defects' = CALCULATE ( [Completed Inspections], KEEPFILTERS ( Inspection[Defects Raised] > 0 ) )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: f654f00e-b972-53d9-b1d3-d196e2b64d77

	/// Share of completed inspections that raised at least one new defect.
	measure 'Defect Find Rate' = DIVIDE ( [Inspections With Defects], [Completed Inspections] )
		formatString: 0%
		displayFolder: Inspections
		lineageTag: bf919181-c430-59b4-aac1-34dc265a852a

	/// Distinct assets with a completed inspection.
	measure 'Assets Inspected' = CALCULATE ( DISTINCTCOUNT ( Inspection[Asset_key] ), KEEPFILTERS ( 'Inspection Status'[InspectionStatusCode] = 0 ) )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: d39703b7-097f-5424-b46c-90b3fc13a627

	/// Distinct active assets with a completed inspection.
	measure 'Active Assets Inspected' = CALCULATE ( [Assets Inspected], KEEPFILTERS ( 'Asset Status'[AssetStatusCode] = 0 ) )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: da2602ba-cb0a-5fb5-80f3-ae5bd4667be8

	/// Share of active assets with at least one completed inspection in the selected period.
	measure 'Inspection Coverage' = DIVIDE ( [Active Assets Inspected], [Active Assets] )
		formatString: 0%
		displayFolder: Inspections
		lineageTag: cc16248b-a08a-5d84-a576-c5f7d7af9b0f

	/// Distinct people who carried out the inspections in context.
	measure Inspectors = CALCULATE ( DISTINCTCOUNT ( 'Inspected By Fact'[Contact_key] ), Inspection )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: 1fdde6fa-99c3-5a61-9577-63fcc3ad88dc

	/// Average completed inspections per month, over months in context that have at least one.
	measure 'Monthly Average Inspections' = AVERAGEX ( VALUES ( 'Date'[Month Start] ), [Completed Inspections] )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: 7ae86dd5-a5f4-5243-bf0b-d1d016c1036b

	/// Monthly average over the whole selected period, for a constant reference line on monthly charts (blank for future months, so they don't appear on the axis).
	measure 'Monthly Average Line' = IF ( MIN ( 'Date'[Date] ) <= TODAY (), CALCULATE ( [Monthly Average Inspections], ALLSELECTED ( 'Date' ) ) )
		formatString: #,0
		displayFolder: Inspections
		lineageTag: d3ebf9f2-828f-5fd0-90c8-a335404940e8

	/// Inspection type with the most completed inspections; ties are reported.
	measure 'Most Common Inspection Type' =
			VAR Items = FILTER ( ADDCOLUMNS ( VALUES ( 'Inspection Type'[Inspection Type] ), "@Value", [Completed Inspections] ), NOT ISBLANK ( [@Value] ) )
			VAR Target = MAXX ( Items, [@Value] )
			VAR Leaders = FILTER ( Items, [@Value] = Target )
			VAR LeaderCount = COUNTROWS ( Leaders )
			VAR FirstLeader = MINX ( Leaders, 'Inspection Type'[Inspection Type] )
			RETURN
			    IF ( LeaderCount > 1, FirstLeader & " (+" & ( LeaderCount - 1 ) & " tied)", FirstLeader )
		displayFolder: Inspections
		lineageTag: 1f13fff1-3992-5eec-9ff7-66def8df54fd

	/// Average percentage score of scored inspections (inspections without a score, -1, are excluded).
	measure 'Average Score' = CALCULATE ( AVERAGE ( Inspection[Percentage Score] ), KEEPFILTERS ( Inspection[Percentage Score] >= 0 ) )
		formatString: 0%
		displayFolder: Inspections
		lineageTag: 9c6f39ef-f1fc-5ac0-8eee-463b9198a493

	/// Defects raised (open or closed). Draft (not finalised) and deleted observations are excluded.
	measure 'Defects Raised' = CALCULATE ( COUNTROWS ( Observation ), KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] IN { 1, 32 } ), KEEPFILTERS ( Observation[IsFinalised] = TRUE () ), KEEPFILTERS ( Observation[Deleted] = FALSE () ) )
		formatString: #,0
		displayFolder: Defects
		lineageTag: b0575f39-eca2-5d6f-9ae3-43409974e621

	/// Defects still open, raised in the period in context.
	measure 'Open Defects' = CALCULATE ( [Defects Raised], KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] = 1 ) )
		formatString: #,0
		displayFolder: Defects
		lineageTag: 592de991-5fb3-5c97-837a-f03d152bbc45

	/// All defects open as at the last data refresh, whenever they were raised.
	measure 'Open Defects Now' = CALCULATE ( [Open Defects], REMOVEFILTERS ( 'Date' ) )
		formatString: #,0
		displayFolder: Defects
		lineageTag: b6ac9702-f0bd-5bd0-8379-147abc44582c

	/// Defects closed in the period in context (by close date).
	measure 'Closed Defects' = CALCULATE ( [Defects Raised], KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] = 32 ), USERELATIONSHIP ( 'Date'[Date], Observation[Closed Date] ) )
		formatString: #,0
		displayFolder: Defects
		lineageTag: 5b0187f6-2674-58e3-aa30-9b774d9e1d43

	/// Average days from a defect being raised to being closed, for defects closed in the period.
	measure 'Average Days To Close' =
			CALCULATE (
			    AVERAGE ( Observation[Days Open] ),
			    KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] IN { 1, 32 } ), KEEPFILTERS ( Observation[IsFinalised] = TRUE () ), KEEPFILTERS ( Observation[Deleted] = FALSE () ),
			    KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] = 32 ),
			    USERELATIONSHIP ( 'Date'[Date], Observation[Closed Date] )
			)
		formatString: #,0
		displayFolder: Defects
		lineageTag: 0e326487-e5cd-5a93-9376-b54fe465a351

	/// Average days open, for defects still open (as at the last data refresh).
	measure 'Average Open Defect Age' =
			CALCULATE (
			    AVERAGE ( Observation[Days Open] ),
			    KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] IN { 1, 32 } ), KEEPFILTERS ( Observation[IsFinalised] = TRUE () ), KEEPFILTERS ( Observation[Deleted] = FALSE () ),
			    KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] = 1 )
			)
		formatString: #,0
		displayFolder: Defects
		lineageTag: aefc80b2-aa87-5fab-bae2-6680f07e098f

	/// Days open of the oldest open defect.
	measure 'Oldest Open Defect Days' =
			CALCULATE (
			    MAX ( Observation[Days Open] ),
			    KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] IN { 1, 32 } ), KEEPFILTERS ( Observation[IsFinalised] = TRUE () ), KEEPFILTERS ( Observation[Deleted] = FALSE () ),
			    KEEPFILTERS ( 'Observation Status'[AssetObservationStatusCode] = 1 )
			)
		formatString: #,0
		displayFolder: Defects
		lineageTag: 8e6fc073-c169-5c87-9e02-266e5d3edc1f

	/// Open defects raised more than 90 days ago (as at the last data refresh).
	measure 'Open Defects Over 90 Days' = CALCULATE ( [Open Defects], KEEPFILTERS ( Observation[Open Age Band Order] >= 4 ) )
		formatString: #,0
		displayFolder: Defects
		lineageTag: de017e1e-f79a-5322-bfd4-62147a8a4396

	/// Open defects recorded again by at least one later inspection: known and still not fixed.
	measure 'Defects Seen Again' = CALCULATE ( [Open Defects], KEEPFILTERS ( Observation[Times Seen Again] > 0 ) )
		formatString: #,0
		displayFolder: Defects
		lineageTag: dd7ec7d4-e6b4-5b99-aec2-84cbafa79a78

	/// Asset type with the most defects raised; ties are reported.
	measure 'Most Affected Asset Type' =
			VAR Items = FILTER ( ADDCOLUMNS ( VALUES ( Asset[Asset Type] ), "@Value", [Defects Raised] ), NOT ISBLANK ( [@Value] ) )
			VAR Target = MAXX ( Items, [@Value] )
			VAR Leaders = FILTER ( Items, [@Value] = Target )
			VAR LeaderCount = COUNTROWS ( Leaders )
			VAR FirstLeader = MINX ( Leaders, Asset[Asset Type] )
			RETURN
			    IF ( LeaderCount > 1, FirstLeader & " (+" & ( LeaderCount - 1 ) & " tied)", FirstLeader )
		displayFolder: Defects
		lineageTag: 7d2de8da-0622-504d-9d34-87898e27fbd8

	/// New defects recorded against inspection checklist items (by inspection date); used to rank defect components.
	measure 'Defects Recorded' =
			VAR Recorded = SUM ( 'Inspection Observation Fact'[Recorded Defect Count] )
			RETURN
			    IF ( Recorded > 0, Recorded )
		formatString: #,0
		displayFolder: Defects
		lineageTag: a8e643d5-c042-5afc-aa1f-efb0a2aa6669

	/// Inspection item (e.g. Tyres) with the most new defects; ties are reported.
	measure 'Top Defect Component' =
			VAR Items = FILTER ( ADDCOLUMNS ( VALUES ( 'Inspection Observation Fact'[Workflow Component] ), "@Value", [Defects Recorded] ), NOT ISBLANK ( [@Value] ) )
			VAR Target = MAXX ( Items, [@Value] )
			VAR Leaders = FILTER ( Items, [@Value] = Target )
			VAR LeaderCount = COUNTROWS ( Leaders )
			VAR FirstLeader = MINX ( Leaders, 'Inspection Observation Fact'[Workflow Component] )
			RETURN
			    IF ( LeaderCount > 1, FirstLeader & " (+" & ( LeaderCount - 1 ) & " tied)", FirstLeader )
		displayFolder: Defects
		lineageTag: 5a415966-2fa4-5f2d-a39c-d9fad63edd68

	/// Share of new defects belonging to the inspection item with the most defects.
	measure 'Top Defect Component Share' =
			VAR Components = ADDCOLUMNS ( VALUES ( 'Inspection Observation Fact'[Workflow Component] ), "@Defects", [Defects Recorded] )
			RETURN
			    DIVIDE ( MAXX ( Components, [@Defects] ), [Defects Recorded] )
		formatString: 0%
		displayFolder: Defects
		lineageTag: 255455c6-9e84-5727-bb13-532f2fe762db

	/// Inspection items with new defects in three or more different months.
	measure 'Repeat Defect Components' =
			COUNTROWS (
			    FILTER (
			        VALUES ( 'Inspection Observation Fact'[Workflow Component] ),
			        COUNTROWS ( FILTER ( VALUES ( 'Date'[Month Start] ), [Defects Recorded] > 0 ) ) >= 3
			    )
			) + 0
		formatString: #,0
		displayFolder: Defects
		lineageTag: aca0992f-f5ed-5e19-aba7-45c1bdebd6b3

	/// Assets currently assigned to a site.
	measure 'Assets Assigned To Sites' = CALCULATE ( [Assets], KEEPFILTERS ( 'Assignment Fact'[Is Latest] = TRUE () ), KEEPFILTERS ( 'Assignment Type'[Assignment Type] = "Site" ) )
		formatString: #,0
		displayFolder: Assignments
		lineageTag: a0c64ba3-a214-5968-92fd-15a10f38bced

	/// Assets currently assigned to a person (Work Wallet user).
	measure 'Assets Assigned To People' = CALCULATE ( [Assets], KEEPFILTERS ( 'Assignment Fact'[Is Latest] = TRUE () ), KEEPFILTERS ( 'Assignment Type'[Assignment Type] = "User" ) )
		formatString: #,0
		displayFolder: Assignments
		lineageTag: ea122fec-b460-5ed7-8b78-9f0bed9e786e

	/// Assets with no current site or person assignment.
	measure 'Assets Not Assigned' = [Assets] - [Assets Assigned To Sites] - [Assets Assigned To People]
		formatString: #,0
		displayFolder: Assignments
		lineageTag: ebe30f1e-f8fc-552e-b82d-38a98d9c1366

	/// Distinct sites with assets currently assigned.
	measure 'Sites With Assets' = CALCULATE ( DISTINCTCOUNT ( Assignment[Site] ), KEEPFILTERS ( 'Assignment Fact'[Is Latest] = TRUE () ), KEEPFILTERS ( 'Assignment Type'[Assignment Type] = "Site" ) )
		formatString: #,0
		displayFolder: Assignments
		lineageTag: 47a3ecdc-5c3e-5aa4-b01d-ab6ee67944c1

	/// Distinct people with assets currently assigned.
	measure 'People With Assets' = CALCULATE ( DISTINCTCOUNT ( Assignment[Assigned To] ), KEEPFILTERS ( 'Assignment Fact'[Is Latest] = TRUE () ), KEEPFILTERS ( 'Assignment Type'[Assignment Type] = "User" ) )
		formatString: #,0
		displayFolder: Assignments
		lineageTag: fd1bc9a5-16ed-5b8b-be83-f49b35737ea8

	/// Assignment records (current and past).
	measure Assignments = COUNTROWS ( 'Assignment Fact' )
		formatString: #,0
		displayFolder: Assignments
		lineageTag: 357ed5e4-4b25-5bfe-a0b9-7eaaab9c8201

	/// Assets that have had more than one assignment.
	measure 'Assets Reassigned' = COUNTROWS ( FILTER ( VALUES ( 'Assignment Fact'[Asset_key] ), CALCULATE ( COUNTROWS ( 'Assignment Fact' ) ) > 1 ) ) + 0
		formatString: #,0
		displayFolder: Assignments
		lineageTag: 4b9f1020-5a83-54a7-8760-a89d2cadd392

	/// Average length of past (ended) assignments, in days. Assignments without an end date are excluded.
	measure 'Average Days Per Assignment' =
			AVERAGEX (
			    FILTER ( 'Assignment Fact', 'Assignment Fact'[To] > DATE ( 1900, 1, 1 ) && 'Assignment Fact'[Days] >= 0 ),
			    'Assignment Fact'[Days]
			)
		formatString: #,0
		displayFolder: Assignments
		lineageTag: 940a74d1-14bf-5f9d-b610-bdc4be0e8df6

	/// Property values recorded on assets.
	measure 'Property Values' = COUNTROWS ( 'Property Fact' )
		formatString: #,0
		displayFolder: Properties
		lineageTag: 311c06f1-79b8-55a1-a892-342332510f37

	/// Distinct assets with at least one property value.
	measure 'Assets With Properties' = DISTINCTCOUNT ( 'Property Fact'[Asset_key] )
		formatString: #,0
		displayFolder: Properties
		lineageTag: c9350236-d575-59d0-8095-73c81c7fb31b

	/// Distinct properties with values recorded.
	measure Properties = CALCULATE ( DISTINCTCOUNT ( 'Property'[Property] ), 'Property Fact' )
		formatString: #,0
		displayFolder: Properties
		lineageTag: 426e8dc5-a6b5-5635-a1bc-bff31c972c2d

	/// Distinct shared properties (used across asset types) with values recorded.
	measure 'Shared Properties' = CALCULATE ( DISTINCTCOUNT ( 'Property'[Property] ), 'Property Fact', KEEPFILTERS ( 'Property'[Is Shared Property] = TRUE () ) )
		formatString: #,0
		displayFolder: Properties
		lineageTag: 8d301f2e-5114-5951-a74d-36040b49500d

	/// Completed Inspections for the same-length period immediately before the selected dates.
	measure 'Completed Inspections PP' =
			VAR FirstDay = MIN ( 'Date'[Date] )
			VAR LastDay = MIN ( MAX ( 'Date'[Date] ), TODAY () )
			VAR Days = LastDay - FirstDay + 1
			RETURN
			    CALCULATE ( [Completed Inspections], DATESBETWEEN ( 'Date'[Date], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,0
		isHidden
		displayFolder: Previous Period
		lineageTag: b7849457-e69d-5c33-8509-1b3c93013d4d

	/// Defects Raised for the same-length period immediately before the selected dates.
	measure 'Defects Raised PP' =
			VAR FirstDay = MIN ( 'Date'[Date] )
			VAR LastDay = MIN ( MAX ( 'Date'[Date] ), TODAY () )
			VAR Days = LastDay - FirstDay + 1
			RETURN
			    CALCULATE ( [Defects Raised], DATESBETWEEN ( 'Date'[Date], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,0
		isHidden
		displayFolder: Previous Period
		lineageTag: 06c4d7e6-327d-58a1-8ed5-f4f9a3c0e2fd

	/// Closed Defects for the same-length period immediately before the selected dates.
	measure 'Closed Defects PP' =
			VAR FirstDay = MIN ( 'Date'[Date] )
			VAR LastDay = MIN ( MAX ( 'Date'[Date] ), TODAY () )
			VAR Days = LastDay - FirstDay + 1
			RETURN
			    CALCULATE ( [Closed Defects], DATESBETWEEN ( 'Date'[Date], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,0
		isHidden
		displayFolder: Previous Period
		lineageTag: acf61589-91ee-5d8a-8287-6152a542388f

	/// Average Days To Close for the same-length period immediately before the selected dates.
	measure 'Average Days To Close PP' =
			VAR FirstDay = MIN ( 'Date'[Date] )
			VAR LastDay = MIN ( MAX ( 'Date'[Date] ), TODAY () )
			VAR Days = LastDay - FirstDay + 1
			RETURN
			    CALCULATE ( [Average Days To Close], DATESBETWEEN ( 'Date'[Date], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,0
		isHidden
		displayFolder: Previous Period
		lineageTag: 38e5d840-80c0-5bb2-8d0c-e93895417aa2

	/// Defect Find Rate for the same-length period immediately before the selected dates.
	measure 'Defect Find Rate PP' =
			VAR FirstDay = MIN ( 'Date'[Date] )
			VAR LastDay = MIN ( MAX ( 'Date'[Date] ), TODAY () )
			VAR Days = LastDay - FirstDay + 1
			RETURN
			    CALCULATE ( [Defect Find Rate], DATESBETWEEN ( 'Date'[Date], FirstDay - Days, FirstDay - 1 ) )
		formatString: 0%
		isHidden
		displayFolder: Previous Period
		lineageTag: 60d4d373-53be-5ec6-965b-efdc216ae1f9

	/// Defects Recorded for the same-length period immediately before the selected dates.
	measure 'Defects Recorded PP' =
			VAR FirstDay = MIN ( 'Date'[Date] )
			VAR LastDay = MIN ( MAX ( 'Date'[Date] ), TODAY () )
			VAR Days = LastDay - FirstDay + 1
			RETURN
			    CALCULATE ( [Defects Recorded], DATESBETWEEN ( 'Date'[Date], FirstDay - Days, FirstDay - 1 ) )
		formatString: #,0
		isHidden
		displayFolder: Previous Period
		lineageTag: 97f9dbd8-6cf1-534d-bc76-4d8a7c344f5f

	/// Inspection Coverage for the same-length period immediately before the selected dates.
	measure 'Inspection Coverage PP' =
			VAR FirstDay = MIN ( 'Date'[Date] )
			VAR LastDay = MIN ( MAX ( 'Date'[Date] ), TODAY () )
			VAR Days = LastDay - FirstDay + 1
			RETURN
			    CALCULATE ( [Inspection Coverage], DATESBETWEEN ( 'Date'[Date], FirstDay - Days, FirstDay - 1 ) )
		formatString: 0%
		isHidden
		displayFolder: Previous Period
		lineageTag: 1e6e4eca-c14d-5c82-8afe-4410acd5eac8

	measure 'Completed Trend Label' =
			VAR Cur = [Completed Inspections]
			VAR Prev = [Completed Inspections PP]
			VAR Change = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF (
			        ISBLANK ( Prev ) || Prev = 0,
			        "No earlier period to compare",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0%" ) & " vs previous period"
			    )
		isHidden
		displayFolder: Labels
		lineageTag: 068d3a24-a861-585f-b6eb-2cec781592b6

	measure 'Defects Trend Label' =
			VAR Cur = [Defects Raised]
			VAR Prev = [Defects Raised PP]
			VAR Change = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF (
			        ISBLANK ( Prev ) || Prev = 0,
			        "No earlier period to compare",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0%" ) & " vs previous period"
			    )
		isHidden
		displayFolder: Labels
		lineageTag: 76b5f23d-32a2-5fc8-91af-0cd3836f25e8

	measure 'Closed Trend Label' =
			VAR Cur = [Closed Defects]
			VAR Prev = [Closed Defects PP]
			VAR Change = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF (
			        ISBLANK ( Prev ) || Prev = 0,
			        "No earlier period to compare",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0%" ) & " vs previous period"
			    )
		isHidden
		displayFolder: Labels
		lineageTag: 05eb0f6e-d0bf-5b6c-a85e-423dd611dd5b

	measure 'Days To Close Trend Label' =
			VAR Cur = [Average Days To Close]
			VAR Prev = [Average Days To Close PP]
			VAR Change = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF (
			        ISBLANK ( Prev ) || Prev = 0,
			        "No earlier period to compare",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0%" ) & " vs previous period"
			    )
		isHidden
		displayFolder: Labels
		lineageTag: 816bdf46-ac11-57c6-befe-3c86610f4195

	measure 'Find Rate Trend Label' =
			VAR Cur = [Defect Find Rate]
			VAR Prev = [Defect Find Rate PP]
			RETURN
			    IF (
			        ISBLANK ( Prev ) || ISBLANK ( Cur ),
			        "No earlier period to compare",
			        IF ( Cur >= Prev, "▲ ", "▼ " ) & FORMAT ( ABS ( Cur - Prev ) * 100, "0.0" ) & " pts vs previous period"
			    )
		isHidden
		displayFolder: Labels
		lineageTag: e0cbbaf8-b595-5e77-b446-958e58a1e298

	measure 'Recorded Trend Label' =
			VAR Cur = [Defects Recorded]
			VAR Prev = [Defects Recorded PP]
			VAR Change = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF (
			        ISBLANK ( Prev ) || Prev = 0,
