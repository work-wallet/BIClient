			VAR Cur = [Stock Removed]
			VAR Prev = [Stock Removed PP]
			VAR Change = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF (
			        ISBLANK ( Prev ) || Prev = 0,
