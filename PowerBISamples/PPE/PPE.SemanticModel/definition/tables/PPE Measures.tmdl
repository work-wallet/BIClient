	measure 'Stock Transferred Trend Label' =
			VAR Cur = [Stock Transferred]
			VAR Prev = [Stock Transferred PP]
			VAR Change = DIVIDE ( Cur - Prev, Prev )
			RETURN
			    IF (
			        ISBLANK ( Prev ) || Prev = 0,
			        "No earlier period to compare",
			        IF ( Change >= 0, "▲ ", "▼ " ) & FORMAT ( ABS ( Change ), "0%" ) & " vs previous period"
			    )
		isHidden
		displayFolder: Labels
		lineageTag: 13dbd68d-b91a-5ca3-8934-8a1a4b6d5126

	measure 'Replacement Due Label' =
			VAR IssuedCount = [PPE Issued]
			RETURN
			    IF ( IssuedCount > 0, FORMAT ( DIVIDE ( [Replacement Due] + 0, IssuedCount ), "0%" ) & " of issued PPE" )
		isHidden
		displayFolder: Labels
		lineageTag: 2deb2ae6-39d4-5968-82d8-4a416794240a

	measure 'People Needing Replacements Label' =
			VAR PeopleCount = [People Needing Replacements] + 0
			RETURN
			    IF ( NOT ISBLANK ( [PPE Issued] ), FORMAT ( PeopleCount, "#,0" ) & IF ( PeopleCount = 1, " person affected", " people affected" ) )
		isHidden
		displayFolder: Labels
		lineageTag: 8472e708-e461-530a-9fcc-57884f76c108

	measure 'Issued Label' =
			VAR PeopleCount = [People With PPE] + 0
			RETURN
			    IF ( NOT ISBLANK ( [PPE Issued] ), "To " & FORMAT ( PeopleCount, "#,0" ) & IF ( PeopleCount = 1, " person", " people" ) )
		isHidden
		displayFolder: Labels
		lineageTag: a487fd78-310e-5473-b8be-01cefbd0b5b4

	measure 'Companies Label' =
			VAR CompanyCount = [Companies With PPE] + 0
			RETURN
			    IF ( NOT ISBLANK ( [PPE Issued] ), "Across " & FORMAT ( CompanyCount, "#,0" ) & IF ( CompanyCount = 1, " company", " companies" ) )
		isHidden
		displayFolder: Labels
		lineageTag: d37849e7-a2ae-5ae6-8cd3-f775deebf834

	measure 'Expiring Soon Label' = "Reaching the end of their lifespan within 30 days"
		isHidden
		displayFolder: Labels
		lineageTag: d6d07135-3df3-5714-87da-ff5d45540b66

	measure 'Expired Label' =
			VAR Oldest = [Oldest Expired Days]
			RETURN
			    IF ( NOT ISBLANK ( Oldest ), "Oldest expired " & FORMAT ( Oldest, "#,0" ) & " days ago", "None past their lifespan" )
		isHidden
		displayFolder: Labels
		lineageTag: 8fb9eddc-ca4c-5812-b758-28500e1cc134

	measure 'Replacement Requested Label' = "Requested in Work Wallet, not yet replaced"
		isHidden
		displayFolder: Labels
		lineageTag: 483a515a-9412-5f1c-8b46-3178e60d3a28

	measure 'Most Common Replacement Text' =
			VAR LabelText = [Most Common Replacement]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( LabelText ), "No replacements due",
			        LEN ( LabelText ) > 40, LEFT ( LabelText, 39 ) & "…",
			        LabelText
			    )
		isHidden
		displayFolder: Labels
		lineageTag: 8c521f0e-8010-54a8-8afb-ea0e88b79d35

	measure 'Most Common Replacement Label' =
			VAR Types = ADDCOLUMNS ( VALUES ( 'PPE Type'[PPE] ), "@Due", [Replacement Due] )
			VAR Highest = MAXX ( Types, [@Due] )
			RETURN
			    IF ( Highest > 0, FORMAT ( Highest, "#,0" ) & " due for replacement" )
		isHidden
		displayFolder: Labels
		lineageTag: 208c5a85-964a-589f-9436-ade9bb9507df

	measure 'Stock On Hand Label' =
			VAR LocationCount = [Stock Locations] + 0
			RETURN
			    IF ( NOT ISBLANK ( [Stock Lines] ), "At " & FORMAT ( LocationCount, "#,0" ) & IF ( LocationCount = 1, " location", " locations" ) )
		isHidden
		displayFolder: Labels
		lineageTag: 066779b7-c745-5157-ae66-f24d1638f54d

	measure 'Low Stock Label' =
			VAR WithWarning = CALCULATE ( [Stock Lines], KEEPFILTERS ( Stock[Warning Quantity] > 0 ) ) + 0
			RETURN
			    IF ( NOT ISBLANK ( [Stock Lines] ), "Of " & FORMAT ( WithWarning, "#,0" ) & " with a warning quantity set" )
		isHidden
		displayFolder: Labels
		lineageTag: 7559e8d0-aab5-59e8-b6fa-318f109a75dd

	measure 'Out Of Stock Label' =
			VAR LineCount = [Stock Lines]
			RETURN
			    IF ( LineCount > 0, FORMAT ( DIVIDE ( [Out Of Stock Lines] + 0, LineCount ), "0%" ) & " of stock records" )
		isHidden
		displayFolder: Labels
		lineageTag: 0a6a5c61-c0c1-5ec0-8324-8d4711feaee8

	measure 'Stock Value Label' =
			VAR WithValue = [PPE Types With Value]
			VAR TypeCount = COUNTROWS ( 'PPE Type' )
			RETURN
			    IF ( TypeCount > 0, FORMAT ( WithValue, "#,0" ) & " of " & FORMAT ( TypeCount, "#,0" ) & " PPE types have a value set" )
		isHidden
		displayFolder: Labels
		lineageTag: ee09e967-b34d-5272-8a60-a6cb365ddd81

	measure 'Issued Value Label' =
			VAR IssuedCount = [PPE Issued]
			RETURN
			    IF ( IssuedCount > 0, "For " & FORMAT ( IssuedCount, "#,0" ) & " items issued" )
		isHidden
		displayFolder: Labels
		lineageTag: 1eb405f4-7123-59b3-9268-756a751cdc4f

	measure 'Removed Value Label' = "Issued PPE taken out of use"
		isHidden
		displayFolder: Labels
		lineageTag: 451d76b0-3e77-510a-a248-a8906de165e9

	measure 'Stock Removed Value Label' = "Stock removed from stores"
		isHidden
		displayFolder: Labels
		lineageTag: de93e0a0-12c0-5e4f-a7b9-a1cb50bfa4ec

	measure 'PPE Types Label' = "Types set up in Work Wallet"
		isHidden
		displayFolder: Labels
		lineageTag: 8fb3c047-fb3d-55d3-a407-d2f022ea37cc

	measure 'Peak Month Label' =
			VAR Months = ADDCOLUMNS ( VALUES ( 'Date'[Month Start] ), "@Issued", [PPE Issued In Period] )
			VAR Peak = MAXX ( Months, [@Issued] )
			VAR PeakMonth = MAXX ( FILTER ( Months, [@Issued] = Peak ), 'Date'[Month Start] )
			RETURN
			    IF ( NOT ISBLANK ( Peak ), "Peak " & FORMAT ( Peak, "#,0" ) & " in " & FORMAT ( PeakMonth, "mmm yyyy" ) )
		isHidden
		displayFolder: Labels
		lineageTag: 6418b474-d581-5468-9e9c-a94e5bab993a

	measure 'Most Issued PPE Text' =
			VAR LabelText = [Most Issued PPE]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( LabelText ), "None issued in this period",
			        LEN ( LabelText ) > 40, LEFT ( LabelText, 39 ) & "…",
			        LabelText
			    )
		isHidden
		displayFolder: Labels
		lineageTag: af6eca2e-db8f-56b0-93d4-689e31675165

	measure 'Most Issued PPE Label' =
			VAR Types = ADDCOLUMNS ( VALUES ( 'PPE Type'[PPE] ), "@Issued", [PPE Issued In Period] )
			VAR Highest = MAXX ( Types, [@Issued] )
			RETURN
			    IF ( Highest > 0, FORMAT ( Highest, "#,0" ) & " issued" )
		isHidden
		displayFolder: Labels
		lineageTag: ff2133f1-cc3b-5c46-b551-27dce45cee9e

	/// Subtitle for the properties table that explains an empty table.
	measure 'Properties Subtitle' = IF ( ISBLANK ( [Property Values] ), "No PPE properties recorded in Work Wallet", "Property values recorded on each PPE type and variant" )
		isHidden
		displayFolder: Labels
		lineageTag: 987a423d-30be-570f-9da4-c12b7803aa18

	measure 'Property Values Label' = "Recorded on PPE types"
		isHidden
		displayFolder: Labels
		lineageTag: ef7d4b61-2434-5343-9e6e-771c545fca35

	measure 'PPE Types With Properties Label' = "With at least one property value"
		isHidden
		displayFolder: Labels
		lineageTag: 8a6fa4e5-30d5-5d4a-aba2-8708b76e4582

	measure 'Properties Label' = "Distinct properties with values"
		isHidden
		displayFolder: Labels
		lineageTag: 2928c852-8736-54cd-9c82-7d4030adf77c

	/// Text for the drillthrough button to a person's PPE; reflects the person selected in the table.
	measure 'Person Details Button Label' =
			IF (
			    HASONEVALUE ( 'Assigned To Contact'[Contact] ),
			    "View " & SELECTEDVALUE ( 'Assigned To Contact'[Contact Name] ) & "'s PPE  ›",
			    "Select a person to view their PPE"
			)
		isHidden
		displayFolder: Labels
		lineageTag: c97f3eae-b0d9-5a01-a310-bd67edc293b4

	/// Name of the selected person.
	measure 'Person Name' = IF ( HASONEVALUE ( 'Assigned To Contact'[Contact] ), MAX ( 'Assigned To Contact'[Contact Name] ) )
		isHidden
		displayFolder: Labels
		lineageTag: b2546f1e-dcd8-5ac5-8a5c-8e97ce3350b3

	/// Company (or companies, if the person is a contact at several) of the selected person.
	measure 'Person Company' =
			IF (
			    HASONEVALUE ( 'Assigned To Contact'[Contact] ),
			    VAR Companies = FILTER ( VALUES ( 'Assigned To Contact'[Company] ), LEN ( 'Assigned To Contact'[Company] ) > 0 )
			    RETURN
			        IF ( ISEMPTY ( Companies ), "(No company)", CONCATENATEX ( Companies, 'Assigned To Contact'[Company], ", ", 'Assigned To Contact'[Company], ASC ) )
			)
		isHidden
		displayFolder: Labels
		lineageTag: 5c6596e2-3cd4-5c71-996d-df625b3898b5

	/// Date PPE was last issued to the selected person.
	measure 'Person Last Issued' =
			VAR LastIssued = CALCULATE ( MAX ( Assignment[Assigned On] ) )
			RETURN
			    IF ( NOT ISBLANK ( LastIssued ), FORMAT ( LastIssued, "dd/mm/yyyy" ), "Never issued" )
		isHidden
		displayFolder: Labels
		lineageTag: 7302fc21-bbe5-51f9-afd1-45ac38ec268d

	/// Semantic colour for favourable changes; matches the theme's 'good' colour.
	measure 'Colour Good' = "#2E9E6B"
		isHidden
		displayFolder: Formatting
		lineageTag: 728fa389-d9ea-5eb9-8ee4-831a340458cd

	/// Semantic colour for unfavourable changes; matches the theme's 'bad' colour.
	measure 'Colour Bad' = "#D6493A"
		isHidden
		displayFolder: Formatting
		lineageTag: 0b264724-d5b7-5755-bcdb-293ff9d271e1

	/// Semantic colour for no change or no comparison; matches the theme's secondary text colour.
	measure 'Colour Neutral' = "#4A5568"
		isHidden
		displayFolder: Formatting
		lineageTag: 38d8b5bb-0567-5dea-aa44-299cf5896c48

	/// Issuing more PPE isn't good or bad in itself, so the trend is neutral.
	measure 'Issued Trend Colour' = [Colour Neutral]
		isHidden
		displayFolder: Formatting
		lineageTag: 4e1f694e-aa22-5207-bd01-5ef730ab025d

	measure 'Replacement Due Colour' = IF ( [Replacement Due] > 0, [Colour Bad], [Colour Neutral] )
		isHidden
		displayFolder: Formatting
		lineageTag: efda7868-66db-5cbb-873f-422a8d5e4eb5

	measure 'Low Stock Colour' = IF ( [Low Stock Lines] + [Out Of Stock Lines] > 0, [Colour Bad], [Colour Neutral] )
		isHidden
		displayFolder: Formatting
		lineageTag: 46749281-7f83-50e6-82cc-501f86dd973f

	/// Text colour for an expiry status (replacement due, expires soon, in date).
	measure 'Expiry Status Colour' =
			SWITCH (
			    SELECTEDVALUE ( Assignment[Expiry Status Order] ),
			    1, "#D6493A",
			    2, "#D6493A",
			    3, "#C9901A",
			    4, "#2E9E6B",
			    "#4A5568"
			)
		isHidden
		displayFolder: Formatting
		lineageTag: 06efd521-7a57-5d8e-90d2-d1e6f91d8efd

	/// Text colour for a stock level (out of stock, at or below warning level).
	measure 'Stock Level Colour' = SWITCH ( SELECTEDVALUE ( Stock[Stock Level Order] ), 1, "#D6493A", 2, "#C9901A", "#4A5568" )
		isHidden
		displayFolder: Formatting
		lineageTag: 735a108b-366a-5982-a29c-2babc06d9168

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 55b529cd-90c8-5c51-8af3-739f3cb1baec
		summarizeBy: none
		isNameInferred
		sourceColumn: [Value]

		annotation SummarizationSetBy = Automatic

	partition 'PPE Measures' = calculated
		mode: import
		source = { 1 }

	annotation PBI_Id = 32592013614f5d3eb2f7d75b73c10622

