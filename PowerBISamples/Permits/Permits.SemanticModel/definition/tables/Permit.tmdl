	column Assignees =
			
			VAR _Assignees =
			    ADDCOLUMNS(
			        RELATEDTABLE('Assignee Fact'),
			        "@Name", RELATED(Contact[Contact Name])
			    )
			RETURN
			    IF(
			        ISEMPTY(_Assignees),
			        BLANK(),
			        CONCATENATEX(_Assignees, [@Name], ", ", [@Name], ASC)
			    )
		lineageTag: a06e8cc7-bf0c-4df4-93cc-bf5d4510f001
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Signatories =
			
			VAR _Signatories =
			    ADDCOLUMNS(
			        RELATEDTABLE('Signature Fact'),
			        "@Entry",
			            VAR _Name = 'Signature Fact'[Signed By]
			            VAR _Desc = 'Signature Fact'[Signature Description]
			            RETURN
			                IF(
			                    ISBLANK(_Desc),
			                    _Name,
			                    _Name & " (" & _Desc & ")"
			                )
			    )
			RETURN
			    IF(
			        ISEMPTY(_Signatories),
			        BLANK(),
			        CONCATENATEX(_Signatories, [@Entry], ", ", [@Entry], ASC)
			    )
		lineageTag: 6a79637b-80b8-48b7-8922-44b17a70d109
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Date part of Issued On (blank if never issued; Work Wallet stores 01/01/1900 for 'no date'); relates permits to the Date table.
	column 'Issued Date' =
			VAR IssuedOn = IF ( Permit[Issued On] > DATE ( 1900, 1, 2 ), Permit[Issued On] )
			RETURN
			    IF ( NOT ISBLANK ( IssuedOn ), DATE ( YEAR ( IssuedOn ), MONTH ( IssuedOn ), DAY ( IssuedOn ) ) )
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		lineageTag: b04f6f4b-af54-592f-8c6e-59cbdcff4ad1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// When the permit was issued (blank if never issued).
	column Issued = IF ( Permit[Issued On] > DATE ( 1900, 1, 2 ), Permit[Issued On] )
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		lineageTag: 76ee0660-6443-5c40-99b7-490f6d9a7cbc
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// When the issued permit expires (blank if never issued).
	column Expires = IF ( Permit[Issued Expiry] > DATE ( 1900, 1, 2 ), Permit[Issued Expiry] )
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		lineageTag: 3587c82e-17cb-50dd-9ca0-53f3b343620a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// When the permit was closed out (blank if not closed).
	column Closed = IF ( Permit[Closed On] > DATE ( 1900, 1, 2 ), Permit[Closed On] )
		dataType: dateTime
		formatString: dd/mm/yyyy hh:nn
		lineageTag: 29767b28-8cde-5efb-81a8-85cf4703d45c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Hours from issue to close-out, for closed permits.
	column 'Hours Open' = IF ( NOT ISBLANK ( Permit[Closed] ) && NOT ISBLANK ( Permit[Issued] ), ROUND ( ( Permit[Closed] - Permit[Issued] ) * 24, 1 ) )
		dataType: double
		formatString: #,0.0
		lineageTag: 5d3c5992-881c-5815-b1ce-a421acbfa58c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Sort order for Outcome.
	column 'Outcome Order' =
			VAR Code = RELATED ( 'Status'[PermitStatusCode] )
			VAR TimeLimited = RELATED ( Category[ExpiryTypeId] ) = 1
			RETURN
			    SWITCH (
			        TRUE (),
			        Code IN { 3, 8 }, 1,
			        // Time-limited (Timelapse): Work Wallet closes them automatically at expiry.
			        TimeLimited && NOT ISBLANK ( Permit[Closed] ) && NOT ISBLANK ( Permit[Expires] ) && Permit[Closed] < Permit[Expires], 2,
			        TimeLimited && ( NOT ISBLANK ( Permit[Closed] ) || Code = 4 ), 3,
			        // Close-out required: the status history (Has Been Expired) is authoritative, and is the only test for extended
			        // permits (the extract has the original expiry, not the extended one). Otherwise compare close and expiry times.
			        NOT ISBLANK ( Permit[Closed] ) && Permit[Has Been Expired], 4,
			        NOT ISBLANK ( Permit[Closed] ) && ( Permit[Has Been Extended] || ISBLANK ( Permit[Expires] ) || Permit[Closed] <= Permit[Expires] ), 2,
			        NOT ISBLANK ( Permit[Closed] ), 4,
			        Code = 4 || Permit[Has Been Expired], 5,
			        6
			    )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 1d2ec491-6466-511a-a31c-48813ed22b06
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Live (active or extended); closed out before expiry; ended at expiry (time-limited 'Timelapse' categories, which Work Wallet closes automatically); closed out after expiry (the permit's status history shows it expired, or it was closed after its expiry time); or expired without being closed out. Extended permits are judged by their status history only. 'Other' covers drafts, pending and archived permits never closed.
	column Outcome =
			SWITCH (
			    Permit[Outcome Order],
			    1, "Live",
			    2, "Closed before expiry",
			    3, "Ended at expiry (time-limited)",
			    4, "Closed after expiry",
			    5, "Expired, not closed out",
			    "Other"
			)
		dataType: string
		lineageTag: 3a9e4297-2cee-509d-90a3-fde06b258d3a
		summarizeBy: none
		sortByColumn: 'Outcome Order'

		annotation SummarizationSetBy = Automatic

	/// Opens the permit in Work Wallet (in the user's selected wallet). Blank for deleted permits.
	column Url =
			VAR UrlPath = IF ( RELATED ( 'Status'[PermitStatusCode] ) <> 7, "/HealthAndSafety/PermitToWork/" & LOWER ( Permit[PermitId] ) )
			RETURN
			    IF ( NOT ISBLANK ( UrlPath ), "https://portal.work-wallet.com" & UrlPath )
		dataType: string
		lineageTag: fd3101d3-2f08-5e21-abd4-3e57f2df9ada
		dataCategory: WebUrl
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

